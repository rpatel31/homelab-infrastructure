global:
  scrape_interval: {{ prometheus_scrape_interval }} 

scrape_configs: 
  - job_name: "prometheus" 
    static_configs:
      - targets: 
        - "localhost:9090"

  - job_name: "node_exporter"
    static_configs:
      - targets: 
          - "10.10.10.10:9100"
          - "10.10.50.10:9100"
